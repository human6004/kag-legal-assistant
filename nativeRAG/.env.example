# =========================================================================
# 1. CẤU HÌNH LLM CHAT (DÙNG GEMINI QUA 9ROUTER - CHUẨN KẾT NỐI OPENAI)
# =========================================================================
# Điền API Key và Base URL từ tài khoản 9router của bạn
LLM_API_KEY=your_9router_api_key_here
LLM_BASE_URL=https://api.9router.com/v1
LLM_MODEL=gemini-2.5-flash

# =========================================================================
# 2. CẤU HÌNH EMBEDDING (DÙNG OPENAI CHÍNH HÃNG - CHUẨN KẾT NỐI OPENAI)
# =========================================================================
# Điền API Key từ OpenAI của bạn
EMBEDDING_API_KEY=your_openai_api_key_here
# Để trống nếu dùng server OpenAI chính thức, hoặc điền endpoint riêng nếu có:
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=text-embedding-3-small

# =========================================================================
# 3. THAM SỐ RAG
# =========================================================================
TOP_K=4
TEMPERATURE=0.1
