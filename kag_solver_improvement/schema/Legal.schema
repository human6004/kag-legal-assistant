namespace Legal

Chunk(DoanVanBan): EntityType
     properties:
        content(NoiDung): Text
            index: TextAndVector

LegalDocument(VanBan): EntityType
     properties:
        desc(MoTa): Text
            index: TextAndVector
        semanticType(LoaiNgu): Text
            index: Text
        docNumber(SoHieu): Text
            index: Text
        docType(LoaiVanBan): Text
            index: Text
        issuingBody(CoQuanBanHanh): Text
            index: Text
        dateIssued(NgayBanHanh): Text
            index: Text
        dateEffective(NgayCoHieuLuc): Text
            index: Text
        dateExpired(NgayHetHieuLuc): Text
            index: Text
        status(TrangThaiHieuLuc): Text
            index: Text
        sourceUrl(NguonTraCuu): Text
            index: Text
     relations:
        supersedes(ThayThe): LegalDocument
        supersededBy(BiThayTheBoi): LegalDocument
        amends(SuaDoiBoSung): LegalDocument
        implementsDoc(HuongDanThiHanh): LegalDocument

Article(Dieu): EntityType
     properties:
        desc(MoTa): Text
            index: TextAndVector
        semanticType(LoaiNgu): Text
            index: Text
        articleNumber(SoDieu): Text
            index: Text
     relations:
        belongsTo(ThuocVanBan): LegalDocument
        prohibits(NghiemCam): ProhibitedAct
        imposes(QuyDinhCheTai): Sanction
        obliges(QuyDinhNghiaVu): Obligation
        defines(DinhNghia): LegalTerm
        appliesTo(ApDungCho): RegulatedEntity

ProhibitedAct(HanhViViPham): EntityType
     properties:
        desc(MoTa): Text
            index: TextAndVector
        semanticType(LoaiNgu): Text
            index: Text
     relations:
        prohibitedBy(BiCamTheo): Article
        sanctionedBy(BiXuPhatTheo): Sanction

Sanction(CheTai): EntityType
     properties:
        desc(MoTa): Text
            index: TextAndVector
        semanticType(LoaiNgu): Text
            index: Text
        penaltyType(HinhThucXuPhat): Text
            index: Text
        penaltyAmount(MucPhat): Text
            index: Text
     relations:
        forAct(ApDungChoHanhVi): ProhibitedAct
        basedOn(CanCuPhapLy): Article
        enforcedBy(ThamQuyenXuPhat): Authority

Obligation(NghiaVu): EntityType
     properties:
        desc(MoTa): Text
            index: TextAndVector
        semanticType(LoaiNgu): Text
            index: Text
     relations:
        boundEntity(RangBuocDoiTuong): RegulatedEntity
        basedOn(CanCuPhapLy): Article

RegulatedEntity(DoiTuongApDung): EntityType
     properties:
        desc(MoTa): Text
            index: TextAndVector
        semanticType(LoaiNgu): Text
            index: Text

Authority(CoQuanNhaNuoc): EntityType
     properties:
        desc(MoTa): Text
            index: TextAndVector
        semanticType(LoaiNgu): Text
            index: Text

LegalTerm(ThuatNguPhapLy): EntityType
     properties:
        desc(MoTa): Text
            index: TextAndVector
        semanticType(LoaiNgu): Text
            index: Text
     relations:
        definedIn(DinhNghiaTai): Article

Others(Khac): EntityType
     properties:
        desc(MoTa): Text
            index: TextAndVector
        semanticType(LoaiNgu): Text
            index: Text
